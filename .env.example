# PostgreSQL Деректер базасы
DB_USER=postgres
DB_HOST=localhost
DB_NAME=student_platform
DB_PASSWORD=your_secure_password
DB_PORT=5432

# JWT Secret (өйтейтін)
JWT_SECRET=your-super-secret-key-change-in-production

# Сервер портты
PORT=5000

# SMS (Mobizon.kz). Кілт бос болса, тест режимі: код SMS-сіз экранда көрсетіледі
MOBIZON_API_KEY=
MOBIZON_API_DOMAIN=api.mobizon.kz
# Mobizon-да бекітілген жіберуші аты (міндетті емес)
SMS_SENDER=
