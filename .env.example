# PostgreSQL: бір адрес (Neon, Supabase т.б.) — берілсе, төмендегі DB_* қажет емес
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Немесе бөлек баптаулар
DB_USER=postgres
DB_HOST=localhost
DB_NAME=student_platform
DB_PASSWORD=your_secure_password
DB_PORT=5432

# JWT Secret (өйтейтін)
JWT_SECRET=your-super-secret-key-change-in-production

# Сервер портты
PORT=5000

# Telegram бот (растау коды лезде келеді). @BotFather берген токен.
# Қойылса, SMS орнына Telegram қолданылады
TELEGRAM_BOT_TOKEN=

# SMS (Mobizon.kz). Кілт бос болса, тест режимі: код SMS-сіз экранда көрсетіледі
MOBIZON_API_KEY=
MOBIZON_API_DOMAIN=api.mobizon.kz
# Mobizon-да бекітілген жіберуші аты (міндетті емес)
SMS_SENDER=

# Жүктелетін материалдың ең үлкен көлемі (МБ). Үлкен кітаптарды Google Drive сілтемесімен қосыңыз
MAX_MATERIAL_MB=25

# Vercel Cron құпиясы: таңғы/кешкі Telegram ескертулерін /api/cron/tick арқылы іске қосады
CRON_SECRET=
